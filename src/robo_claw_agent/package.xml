<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>robo_claw_agent</name>
    <version>0.1.0</version>
    <description>RoboClaw AI 에이전트 레이어: LLM 연동, 스킬 매니저, 메모리 관리</description>
    <maintainer email="wkqco33@gmail.com">wkqco</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>ament_cmake_python</buildtool_depend>

    <depend>rclpy</depend>
    <depend>std_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>action_msgs</depend>
    <depend>builtin_interfaces</depend>
    <depend>nav2_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>image_geometry</depend>
    <depend>robo_claw_msgs</depend>
    <depend>task_manager_msgs</depend>
    <depend>control_msgs</depend>
    <depend>trajectory_msgs</depend>
    <depend>std_srvs</depend>
    <depend>python3-numpy</depend>

    <test_depend>ament_cmake_pytest</test_depend>
    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_copyright</test_depend>
    <test_depend>python3-pytest</test_depend>
    <test_depend>python3</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
