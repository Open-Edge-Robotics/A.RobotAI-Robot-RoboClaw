# RoboClaw 환경 변수 설정 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
# cp .env.example .env

# ── 기본 시스템 및 로봇 프로필 설정 ────────────────────────────────
# ROS 2 domain ID (기본값: 0)
# ROS_DOMAIN_ID=0

# 에이전트 식별자 (기본값: robo_claw_agent)
# RC_AGENT_ID=robo_claw_agent

# 구동할 로봇 프로필 (stretch3 | former | butler | sim, 기본값: sim)
# RC_ROBOT_CONFIG=sim

# ── Maestro FleetControl outbound connector ──────────────────────
# MAESTRO_IP가 비어 있으면 connector를 시작하지 않습니다.
# MAESTRO_IP=192.168.10.10
# ROBOT_PORT=50053
# ROBOT_ID=former-01
# ROBOT_SITE_ID=lab
# ROBOT_MAP_ID=floor-1
# ROBOT_MAP_VERSION=v1
# ROBOT_MAP_FRAME_ID=map
# MAESTRO_DISCONNECT_POLICY=complete  # complete | stop | finish_atomic
# FLEET_HEARTBEAT_SEC=1.0
# FLEET_COMMAND_JOURNAL_PATH=/var/lib/robo_claw/fleet_commands.sqlite3
# RC_SKILLS_GUIDE_FILE=/ros2_ws/src/robo_claw_bringup/config/SKILLS.former.md
# 개발 LAN에서만 false 사용. 운영에서는 mTLS를 활성화합니다.
# FLEET_CONTROL_TLS=false
# FLEET_CONTROL_CA_CERT=/run/secrets/ca.crt
# FLEET_CONTROL_CLIENT_CERT=/run/secrets/robot.crt
# FLEET_CONTROL_CLIENT_KEY=/run/secrets/robot.key

# ── LLM 기본 설정 ────────────────────────────────────────────────
# 제공자: ollama, openai, azure, anthropic
RC_LLM_PROVIDER=azure
# 모델명: llama3.2, gpt-4o, gpt-4.1, claude-sonnet-4-6 등
RC_LLM_MODEL=gpt-4.1

# ── Azure OpenAI 설정 ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here

# ── OpenAI 설정 ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── Anthropic 설정 ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ── LangSmith 트레이싱 (선택) ─────────────────────────────────────
# 여러 workspace에 접근 가능한 API key를 사용할 때 지정합니다.
# LANGSMITH_WORKSPACE_ID=workspace-id

# ── Ollama 설정 (로컬/사내망 LLM, 인터넷 불필요) ───────────────────
# RC_LLM_PROVIDER=ollama
# RC_LLM_MODEL=llama3.2               # 대화 모델 (llama3.2, mistral, qwen2.5 등)
# RC_LLM_EMBEDDING_MODEL=nomic-embed-text  # 임베딩 모델 (RAG 사용 시 필요)
# 임베딩 제공자를 별도로 지정해야 하는 경우(예: OpenAI/Azure 임베딩):
# RC_LLM_EMBEDDING_PROVIDER=ollama
# RC_LLM_EMBEDDING_BASE_URL=http://localhost:11434
# RC_LLM_EMBEDDING_API_KEY=your-embedding-api-key
# RC_OLLAMA_BASE_URL=http://localhost:11434  # 원격 Ollama 서버 사용 시 변경
# RC_OLLAMA_OPTIONS_JSON='{"num_ctx":8192,"repeat_last_n":64,"repeat_penalty":1.1,"temperature":0.7,"seed":42,"stop":["AI assistant:"],"num_predict":-1,"draft_num_predict":4,"top_k":40,"top_p":0.9,"min_p":0.0}'
#   * 설정 가능한 전체 옵션 상세 설명:
#     - num_ctx (int): 컨텍스트 윈도우 크기 (기본값: 2048)
#     - repeat_last_n (int): 반복 방지를 위해 되돌아볼 토큰 수 (기본값: 64, 0:비활성, -1:num_ctx)
#     - repeat_penalty (float): 반복에 대한 감점 수준 (기본값: 1.1)
#     - temperature (float): 모델의 창의성 수준 (기본값: 0.8)
#     - seed (int): 무작위 출력 고정용 시드값 (기본값: 0)
#     - stop (list[str]): 생성을 멈출 정지 시퀀스 리스트
#     - num_predict (int): 최대 생성 토큰 수 (기본값: -1, 무제한)
#     - draft_num_predict (int): 투기적 드래프트 토큰 수 (기본값: 4)
#     - top_k (int): 무의미한 토큰 생성 억제값 (기본값: 40)
#     - top_p (float): top_k와 결합하는 확률 필터링 수준 (기본값: 0.9)
#     - min_p (float): 후보 토큰에 포함될 최소 확률 임계값 (기본값: 0.0)
#     - think (bool|str): Qwen3 등 thinking 계열 모델의 추론 단계 제어.
#       options 와 별개인 Ollama API 최상위 파라미터로 여기에 넣으면 자동 분리됨.
#       false = 추론 끔(빠름, SLM 권장), true = 켬, low/medium/high/max = 단계 제어
#
# Qwen3 계열 SLM(qwen3:4b 등)은 thinking 모드가 기본 켜져 있어 응답 전 긴 추론
# 토큰을 생성해 지연이 큽니다. 아래처럼 think:false 를 넣으면 추론을 생략합니다.
#   RC_OLLAMA_OPTIONS_JSON='{"num_ctx":4096,"num_predict":512,"think":false,"temperature":0.7}'
#
# 비전(VLM) 기능 사용 시 멀티모달 모델 필요:
# RC_LLM_MODEL=llava                  # 또는 llava:13b, bakllava 등
#
# Ollama 모델 설치 명령:
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
#   ollama pull llava

# ── 로봇 개성 (Robot Soul) 및 프롬프트 설정 ─────────────────────────
# ROBOT.md 절대 경로. 비워두면 기본 개성 없음.
# 템플릿: src/robo_claw_bringup/config/ROBOT.example.md 참고
# RC_ROBOT_SOUL_FILE=/path/to/ROBOT.md

# 범용 스킬 가이드 파일 (SKILLS.md) 절대 경로. 비워두면 기본 가이드 없음.
# RC_SKILLS_GUIDE_FILE=/path/to/SKILLS.md

# 로봇 구동 한계 스펙 파일 (ROBOT_LIMITS.json) 절대 경로
# RC_ROBOT_LIMITS_FILE=/path/to/ROBOT_LIMITS.json

# 장애 조치 가이드 파일 (TROUBLESHOOTING.md) 절대 경로
# RC_TROUBLESHOOTING_GUIDE_FILE=/path/to/TROUBLESHOOTING.md

# 에이전트 전용 작업 공간 폴더 경로 (호스트) - Docker 마운트 및 호스트 실행 시 로드됨
# RC_AGENT_WORKSPACE_DIR=/path/to/agent_workspace

# 메모리/로컬 벡터(RAG 미러) 저장 디렉토리 (호스트) - Docker 시 /ros2_ws/memory 로 마운트, 재시작 후에도 유지
# RC_MEMORY_DIR=/path/to/memory

# 컨테이너 타임존 (Docker 모드 전용). 호스트의 /etc/localtime 도 마운트됨.
# 비워두면 기본값 Asia/Seoul 이 사용됩니다.
# RC_TZ=Asia/Seoul

# RoboClaw 설정 폴더 경로 (호스트)
# RC_CONFIG_DIR=/path/to/custom/config

# 커스텀 시스템 프롬프트 파일 (스킬 동작 방식 오버라이드)
# RC_SYSTEM_PROMPT_FILE=/path/to/system_prompt.md

# ── RAG / Qdrant 설정 ─────────────────────────────────────────────
# RC_ENABLE_RAG=true
# RC_LLM_EMBEDDING_MODEL=text-embedding-3-small
# RC_RAG_VECTOR_BACKEND=qdrant        # local 또는 qdrant
# RC_RAG_TOP_K=2
# RC_RAG_SCORE_THRESHOLD=0.7
# RC_RAG_LOCAL_MIRROR=true            # Qdrant 사용 시 로컬에도 동시 저장(미러). 원격 다운 시 로컬 폴백 (기본 true)
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=your-qdrant-api-key
# RC_QDRANT_COLLECTION=robo_claw_knowledge
# RC_QDRANT_TIMEOUT_SEC=5.0

# ── 스킬 자가학습 (실패는 항상 수집, 성공은 샘플링; enable_rag 필요) ──
# RC_ENABLE_SKILL_LEARNING=true
# RC_SKILL_LEARNING_SUCCESS_SAMPLE_RATE=0.1   # 성공 경험 샘플링 비율
# RC_SKILL_LEARNING_REFLECT_INTERVAL_SEC=1800 # 교훈 자동 추출 간격(초), 0=비활성

# ── 태스크 큐 / 복합 명령 자동 분해 ────────────────────────────────
# 태스크 큐 최대 대기열 크기. 0이면 큐 비활성화(병렬 실행). 기본값 8.
# RC_TASK_QUEUE_MAX_SIZE=8
# 시작 시 LLM 설정 검증/헬스체크 실패 시 기동 중단. 운영 배포 시 true 권장. 기본값 false.
# RC_LLM_FAIL_FAST=true
# 필수 설정 파일(ROBOT_LIMITS.json, ROBOT.md 등) 누락 시 기동 중단. 운영 배포 시 true 권장. 기본값 false.
# RC_STRICT_CONFIG=true
# 복합 명령("A로 이동해 B하고 C해") 자동 분해 활성화. SLM이 여러 절을 한 번에
# 처리하지 못하는 문제를 보완. 단순 명령에는 영향 없음. 기본값 true.
# RC_ENABLE_TASK_DECOMPOSITION=true
# 복합 명령 분해 시 허용하는 최대 하위 단계 수. 기본값 6.
# RC_TASK_DECOMPOSITION_MAX_STEPS=6
# 분해된 하위 단계 실패 시 동일 단계를 재시도하는 횟수. 기본값 1.
# RC_TASK_STEP_MAX_RETRIES=1
# ExecuteTask 액션이 결과를 기다리는 여유 시간의 상한(초). 복합 명령은 단계 수 ×
# 재시도 횟수에 비례해 여유를 늘리되 이 값을 넘지 않는다. 기본값 1800.0(30분).
# RC_TASK_DECOMPOSITION_WAIT_MARGIN_CAP_SEC=1800.0

# ── HTTP API 보안 설정 ────────────────────────────────────────────
# 기본: 127.0.0.1:8080 바인딩 (로컬 전용)
# RC_HTTP_HOST=127.0.0.1
# RC_HTTP_PORT=8080
# RC_HTTP_READONLY_TOKEN=your-readonly-token
# RC_HTTP_CONTROL_TOKEN=your-control-token
# RC_HTTP_ALLOWED_CIDRS_JSON=["127.0.0.1/32","192.168.0.0/24"]
# RC_HTTP_RATE_LIMIT_PER_MINUTE=60
# RC_HTTP_ALLOWED_SKILLS_JSON=["get_status","navigate_to"]   # 허용 목록 (설정 시 이것만 허용)
# RC_HTTP_BLOCKED_SKILLS_JSON=["emergency_stop","rag_delete"] # 차단 목록

# ── Dashboard 웹 노드 (robo_claw_dashboard) ──────────────────────
# 상태 조회/시각화와 에이전트 메시지 전송용 웹 노드. 기본: 127.0.0.1:9090 바인딩.
# 외부 노출 시 host=0.0.0.0과 함께 반드시 CIDR/토큰(위 RC_HTTP_* 재사용)을 설정한다.
# RC_USE_DASHBOARD=true
# RC_DASHBOARD_HOST=127.0.0.1
# RC_DASHBOARD_PORT=9090
# 위 HTTP 토큰 RC_HTTP_READONLY_TOKEN(=/api/status), RC_HTTP_CONTROL_TOKEN(=/api/chat) 활용

# ── MCP(Model Context Protocol) 서버 연동 ─────────────────────────
# MCP 서버 연동 전체 사용 여부. false면 아래 목록이 있어도 로드하지 않음.
# RC_ENABLE_MCP=false
# 연결할 MCP 서버 목록 JSON 배열. 각 항목은 transport(stdio|sse|streamable_http)에 따라
# 아래 필드를 사용 (mcp_adapter.MCPManager.load_servers가 파싱하는 형식과 동일):
#   stdio: name, transport, command, args(optional), env(optional), cwd(optional)
#   sse  : name, transport, url, headers(optional), connect_timeout_sec(optional, 기본 5.0),
#          read_timeout_sec(optional, 기본 300.0)
#   streamable_http: name, transport, url, headers(optional)
# 예: RC_MCP_SERVERS_JSON='[{"name":"filesystem","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]},{"name":"remote-sse","transport":"sse","url":"https://example.com/mcp/sse","headers":{"Authorization":"Bearer your-token"}},{"name":"remote-http","transport":"streamable_http","url":"https://example.com/mcp"}]'
# RC_MCP_SERVERS_JSON=[]

# ── 메신저 연동 활성화 설정 ───────────────────────────────────────
ENABLE_DISCORD=true
ENABLE_TELEGRAM=false
ENABLE_SLACK=false
ENABLE_GRPC=true
USE_GRPC=false
ENABLE_GRPC_CLIENT=false
# RoboMessenger 서버 포트 (기본값: 50052, 외부 CLOi 래퍼 사용 시: 50152)
ROBO_CLAW_GRPC_PORT=50052

# ── gRPC 메신저 클라이언트 (동료 로봇 소통) 설정 ───────────────────────
# 기본 1:1 연결 타겟
GRPC_TARGET_HOST=127.0.0.1
GRPC_TARGET_PORT=50052
# 다중 동료 로봇(1:N) 연결용 JSON 리스트 (설정 시 우선 적용)
# 예: GRPC_TARGET_PEERS_JSON=[{"host":"192.168.1.10","port":50052,"agent_name":"butler","description":"집게 팔 장착 매니퓰레이터 로봇","role":"manipulator"},{"host":"192.168.1.11","port":50052,"agent_name":"former","description":"이동형 카트 로봇","role":"agv"}]
GRPC_TARGET_PEERS_JSON=[]
# gRPC peer 공통 인증 토큰. 비어 있으면 인증하지 않음. 실기에서는 로봇별로 안전한 랜덤 값을 사용하세요.
GRPC_PEER_TOKEN=
# 다중 peer별 개별 인증 토큰 JSON 맵 (설정 시 GRPC_PEER_TOKEN 대신 우선 적용)
# GRPC_PEER_TOKENS_JSON='{"butler":"token-for-butler","former":"token-for-former"}'
# gRPC peer 간 파일 전송 최대 크기(바이트, 기본값: 67108864 = 64MB)
# GRPC_MAX_FILE_BYTES=67108864
# gRPC peer 중복 메시지 수신 방지 SQLite DB 경로 (기본값: /tmp/robo_claw_peer_dedup.sqlite3)
# GRPC_DEDUP_PATH=/tmp/robo_claw_peer_dedup.sqlite3

# ── 메신저 연동 토큰 (활성화된 서비스만 채우세요) ──────────────────
# Discord (실시간 양방향 제어 권장)
DISCORD_BOT_TOKEN=your-discord-bot-token

# Slack
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Telegram
TELEGRAM_BOT_TOKEN=123456:your-telegram-token

# ── 로봇 하드웨어 및 전용 경로 설정 ────────────────────────────────
# URDF 파일 경로 (커스텀 로봇 사용 시)
# RC_ROBOT_DESCRIPTION_FILE=/path/to/robot.urdf
# Butler 로봇 전용 스크립트 디렉토리 (Docker 마운트용, 기본값: /ros2_ws/butler_scripts)
# RC_BUTLER_SCRIPTS_DIR=/ros2_ws/butler_scripts
# Butler 로봇 ROS 2 워크스페이스 소스 디렉토리 (Docker 마운트 및 소싱용)
# RC_BUTLER_SOURCE_DIR=/path/to/butler_workspace

# ── 카메라 / 비전 설정 (Head Camera) ───────────────────────────────
# 카메라 이미지 토픽 (로봇 프로필 기본값 오버라이드). 비워두면 launch 파일이
# robot_config에 따라 자동 선택 (/oakd/rgb/preview/image_raw 등).
# RC_CAMERA_TOPIC=/oakd/rgb/preview/image_raw
# ONNX 객체 인식 비전 노드(object_detector_node) 활성화 (true/false)
# 기본값 true. object_detector_node는 구독자가 없거나(스킬 미사용 시) max_inference_hz
# 상한을 넘으면 추론을 건너뛰므로 상시 실행해도 저사양 로봇 부담이 적다.
# 완전히 끄려면 false로 설정.
# RC_USE_VISION=true
# ONNX 모델 파일명 (기본값: yolov8n). RC_VISION_MODEL_PATH 미지정 시 사용.
# RC_MODEL_NAME=yolov8n
# ONNX 모델 파일 절대 경로 (use_vision=true 시 필수: ./download_model.sh 로 사전 다운로드 필요)
# RC_VISION_MODEL_PATH=/ros2_ws/models/yolov8n.onnx
# RC_VISION_MAX_INFERENCE_HZ=10.0
# 모델 저장/마운트 디렉토리 (호스트 경로). download_model.sh는 여기에 모델을 받고,
# docker 모드(run_robo_claw_docker.sh / run_former_docker.sh)는 이 경로를 컨테이너의
# /ros2_ws/models 에 마운트한다. 비워두면 저장소 루트의 models/ 를 사용.
# RC_MODELS_DIR=/path/to/models

# ── 그리퍼 카메라 / 비전 설정 (Stretch3 등 매니퓰레이터 로봇 전용) ────
# 그리퍼 RGB 카메라 이미지 토픽 (기본값: /stretch/gripper_camera/image_raw)
# RC_GRIPPER_CAMERA_TOPIC=/stretch/gripper_camera/image_raw
# 그리퍼 정렬 깊이(depth) 이미지 토픽
# RC_GRIPPER_DEPTH_TOPIC=/stretch/gripper_camera/depth/image_raw
# 그리퍼 카메라 정보(CameraInfo) 토픽
# RC_GRIPPER_CAMERA_INFO_TOPIC=/stretch/gripper_camera/depth/camera_info
# 그리퍼 포인트클라우드 토픽
# RC_GRIPPER_POINTCLOUD_TOPIC=/stretch/gripper_camera/depth/color/points
# 그리퍼 ONNX 객체 인식 비전 노드 활성화 (true/false)
# RC_USE_GRIPPER_VISION=false
# 그리퍼 비전 최대 추론 주기 (Hz, 기본값: 10.0)
# RC_GRIPPER_VISION_MAX_INFERENCE_HZ=10.0

# ── 자가진단용 센서 토픽 ──────────────────────────────────────────
# 에이전트 자가진단(_check_sensors_cached)이 점검할 센서 토픽.
# 비워두면 robot_config YAML(butler_config.yaml 등)의 값을 사용.
# butler: /scan, /imu/data | former: /scan, /imu_raw | sim: /scan, /imu
# RC_LIDAR_TOPIC=/scan
# RC_IMU_TOPIC=/imu/data

# ── 디버그 및 네트워크 설정 ───────────────────────────────────────
# true 설정 시 ROS 2 DEBUG 레벨 로깅 활성화 (./rclaw run --debug 와 동일)
# RC_DEBUG=false
# ROS 2 미들웨어 구현 (DDS 변경 시 설정, 예: rmw_cyclonedds_cpp, rmw_fastrtps_cpp)
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# CycloneDDS 설정 파일 경로 또는 인라인 XML (미설정 시 ./rclaw run/sim 내부 기본값 사용)
# CYCLONEDDS_URI=/path/to/cyclonedds.xml

# =====================================================================
# LangSmith 트레이싱 / 모니터링 (선택)
# =====================================================================
# LLM 호출(계획 수립, RAG 쿼리 재작성, 임베딩, 이미지 분석)을 LangSmith에서 추적한다.
# LANGSMITH_TRACING=true 이고 LANGSMITH_API_KEY 가 설정되어야 트레이스가 업로드된다.
# robo_claw_cli 사용 시 LangSmith 값은 원격 config.json 설정이 .env보다 우선할 수 있습니다.
# 주의: ./rclaw run / sim 은 이 .env 의 LANGSMITH_* 를 에이전트에 전달하지 않습니다(셸에서 export 필요).
#       scripts/run_robo_claw_docker.sh 는 --env-file 로 전달하고, ./rclaw launch 는 AI Config Server 프로필 값을 씁니다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
# (선택) LangSmith 프로젝트 이름 — 미설정 시 "default"
LANGSMITH_PROJECT=former-0045-claw
# (선택) 자체 호스팅/프록시 엔드포인트 — 미설정 시 공식 SaaS 사용
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# =====================================================================
# System 1 Fast Router — Laya 사전 라우팅 (선택)
# =====================================================================
# LLM 호출 전 사전 라우팅을 규칙(rule)과 Laya System 1 모델(laya) 중 하나만 쓴다(배타 선택).
# 상세: docs/SYSTEM1_FAST_ROUTER.md (환경변수·실행 방식별 설정 위치·운영 절차)
# 주의: 이 .env 값은 scripts/run_robo_claw_docker.sh 실행 시에만 전달됩니다.
#       ./rclaw run / ./rclaw launch 는 셸에서 export 해야 하며, ./rclaw launch --docker 는 현재 전달할 수 없습니다.
# rule(기본) = 기존 동작 그대로 / laya = Laya 만 판단, Laya 장애 시 해당 요청만 rule 로 자동 대체
SYSTEM1_ROUTER=rule
# 선택되지 않은 라우터도 백그라운드로 실행해 판단만 기록(실행에는 영향 없음)
# SYSTEM1_SHADOW=false
# (선택) 그림자 기록을 JSONL 파일로 남길 경로
# SYSTEM1_SHADOW_LOG=/tmp/robo_claw_system1_shadow.jsonl
# laya 모드에서 Laya 단독 실행 허용 범위: readonly(인자 없는 read 스킬) | navigation(+ 기억된 장소로 navigate_to)
# SYSTEM1_SCOPE=readonly
# laya-serve 주소 (POST {SYSTEM1_ENDPOINT}/v1/systemone)
# SYSTEM1_ENDPOINT=http://localhost:8000
# SYSTEM1_PROVIDER=laya
# SYSTEM1_TIMEOUT_MS=300
# intent별 confidence 임계값(그림자 모드 데이터로 조정)
# SYSTEM1_CONF_THRESHOLDS_JSON={"smalltalk":0.9,"single_skill":0.85,"skill":0.8,"target_place":0.8,"ambiguous":0.5}
# (선택) Laya 후보 스킬을 직접 지정(쉼표 구분). 미설정 시 인자 없는 read 스킬 전체(최대 SYSTEM1_MAX_OPTIONS개)
# SYSTEM1_SKILLS=get_status,identify_location,describe_surroundings
# SYSTEM1_MAX_OPTIONS=12
# (선택) 외부 유료 provider(Jev 등) 사용 시에만 — 자체 호스팅 Laya 는 불필요
# SYSTEM1_API_KEY=

# =====================================================================
# RoboClaw CLI / AI Config Server 연동 (선택)
# =====================================================================
# robo_claw_cli가 중앙 AI Config Server에서 프로필을 동기화(fetch/launch)할 때 사용
# 컨테이너 launch에는 실제 활성 프로필, 접속 가능한 서버 주소, 발급된 디바이스 토큰이 필요합니다.
# ROBO_CLAW_PROFILE_ROBOT=<active-profile-robot-name>
# ROBO_CLAW_PROFILE_ENVIRONMENT=<active-profile-environment>
# ROBO_CLAW_CLI_DEVICE_TOKEN=<device-token-from-secret-store>
# 기본 HTTPS. 서버 호스트는 0.0.0.0이 아닌 실제 DNS/IP 주소로 지정합니다.
# ROBO_CLAW_CLI_SERVER_HOST=<ai-config-server-host>
# ROBO_CLAW_CLI_SERVER_PORT=8080
# 개발용 평문 HTTP에서만 필요한 경우 true로 설정합니다.
# ROBO_CLAW_CLI_SERVER_ALLOW_INSECURE_HTTP=false
# ROBO_CLAW_CLI_LOG_LEVEL=info
