[Unit]
Description=__ROBOT_ID__ 로봇 베이스 bringup (former_robot container)
Documentation=file://__AUTOSTART_DIR__/../FORMER_GUIDE.md
Requires=docker.service dev-ttyARDUINO.device dev-ttyIMU.device dev-ttyMOTOR.device
Wants=network-online.target
After=docker.service network-online.target dev-ttyARDUINO.device dev-ttyIMU.device dev-ttyMOTOR.device realsense_bringup.service
# 재기동 폭주를 막는다. base_controller 가 계속 죽는 상황(하드웨어 미연결 등)에서
# 5분에 5회를 넘으면 failed 로 남겨 관리자가 보게 한다.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=former
Group=former
Environment=HOME=__ROBOT_HOME__
Environment=ROS_DOMAIN_ID=4
WorkingDirectory=__ROBOT_HOME__
# 이전 실행(수동 기동 포함)이 남긴 동명 컨테이너를 정리한다. 없으면 무시한다.
ExecStartPre=-/usr/bin/docker rm -f former_robot
# DDS 는 cyclonedds.xml 의 인터페이스에만 바인딩된다. 그 인터페이스 주소가 붙기 전에
# 참가자를 만들면 rmw_create_node 가 실패해 ros2_control_node / robot_state_publisher 가
# 죽는다(2026-10-29 former0045). 컨테이너를 띄우기 전에 주소를 기다린다.
ExecStartPre=/bin/bash __AUTOSTART_DIR__/wait_for_net.sh
ExecStart=/usr/bin/docker run --rm -i --net=host --name former_robot -e ROS_DOMAIN_ID=4 --privileged -v /dev:/dev -v __ROBOT_HOME__/dev_ws/src:/root/dev_ws/src:z -v __ROBOT_HOME__/cyclonedds_conf:/root/cyclonedds_conf:z former_docker:1.0 ros2 launch former_bringup bringup_robot.launch.py __BASE_LAUNCH_ARGS__
ExecStop=/usr/bin/docker stop --time 30 former_robot
# 전경 실행이라 launch 가 죽으면 unit 도 종료된다. 컨테이너 안의 개별 노드 사망은
# former_bringup_watchdog.timer 가 잡는다.
Restart=always
RestartSec=10
TimeoutStopSec=60
SyslogIdentifier=former-bringup

[Install]
WantedBy=multi-user.target
