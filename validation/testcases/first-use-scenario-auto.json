{
  "name": "First-Use 시나리오 자동 검증 (RAG 위치 지식 개선 P1~P5)",
  "description": "first-use-scenario-test-gemma4_31b.md 를 robo_claw_cli custom 러너용으로 자동화. 방식 A(navigate_to 좌표로 이동 후 현재 위치 저장). 핵심 판정: fail_keywords '[스킬' 로 내부 스킬 로그 누수(이번 버그)를 검출한다. 좌표 3곳(충전대/거실/키친)은 맵 w2_2f_2 기준 예시값이므로 실제 도달 가능 좌표로 수정할 것.",
  "test_cases": [
    {
      "id": "tc00_ping",
      "name": "0. 연결성 확인",
      "step": "Phase 0",
      "type": "ping",
      "timeout_ms": 5000,
      "enabled": true
    },

    {
      "id": "tc01_nav_charger",
      "name": "1. 충전대 지점으로 이동",
      "step": "Phase 1 (충전대)",
      "type": "custom",
      "timeout_ms": 180000,
      "enabled": true,
      "params": {
        "prompt": "x=3.96, y=0.83 으로 이동해",
        "expect_success": true,
        "expected_keywords": ["이동"],
        "fail_keywords": ["실패", "[스킬"]
      }
    },
    {
      "id": "tc02_save_charger",
